/build
.planning/
.vscode/

# Generated by Cargo
# will have compiled files and executables
debug/
target/
coverage/

# Track the executable workspace lockfile, but ignore lockfiles from nested helper crates.
**/Cargo.lock
!/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
